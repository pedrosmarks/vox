# Copie este arquivo para .env e preencha com suas credenciais
# cp .env.example .env

# Banco de dados
DB_USERNAME=
DB_PASSWORD=

# Cloudinary (https://cloudinary.com)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# LiveKit (https://livekit.io)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# SMTP (ex: Gmail, Brevo, SendGrid)
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=

# App
MAIL_FROM=
FRONTEND_RESET_URL=
